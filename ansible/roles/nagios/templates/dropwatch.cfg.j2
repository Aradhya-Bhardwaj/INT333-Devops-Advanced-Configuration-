define host {
    use                 linux-server
    host_name           dropwatch-app
    alias               DropWatch app server
    address             {{ groups['app'][0] }}
    check_command       check_tcp!80
}

define service {
    use                 generic-service
    host_name           dropwatch-app
    service_description DropWatch homepage
    check_command       check_http!--url=/
}

define service {
    use                 generic-service
    host_name           dropwatch-app
    service_description DropWatch login page
    check_command       check_http!--url=/login/
}
